{
  "name": "maindulu",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "account:reset": "node scripts/reset-account.mjs",
    "account:role": "node scripts/set-account-role.mjs",
    "data:backup": "node scripts/data-backup.mjs backup",
    "data:verify": "node scripts/data-backup.mjs verify",
    "data:restore": "node scripts/data-backup.mjs restore",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test --config=playwright.production.config.ts",
    "test:e2e:backend": "playwright test --config=playwright.backend.config.ts",
    "build:demo": "node scripts/build-demo.mjs",
    "vendor:engine": "node scripts/vendor-engine.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.7",
    "@noble/hashes": "2.4.0",
    "fastify": "^5.12.7",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "esbuild": "^0.25.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
