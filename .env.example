# Salin ke .env di akar repo untuk pengembangan lokal (npm start).
# HANYA localhost: password, cookie sesi, dan save tidak terenkripsi.
MAIN_DULU_HOST=127.0.0.1
MAIN_DULU_PORT=7777
MAIN_DULU_PUBLIC_ORIGIN=http://localhost:7777
MAIN_DULU_ALLOW_INSECURE_HTTP=true
MAIN_DULU_REGISTRATION_OPEN=true

# Opsional: batas state/progres/cadangan (nilai default ditunjukkan).
# MAIN_DULU_STATE_MAX_BYTES=33554432
# MAIN_DULU_GAME_SAVE_MAX_BYTES=8388608
# MAIN_DULU_SAVE_QUOTA_BYTES=268435456
# MAIN_DULU_CATALOG_QUOTA_BYTES=21474836480
# MAIN_DULU_CATALOG_MIN_FREE_BYTES=268435456
# MAIN_DULU_CATALOG_UPLOAD_LIMIT=2
# MAIN_DULU_CATALOG_UPLOAD_TIMEOUT_MS=1800000

# ScreenScraper runtime, opt-in pribadi/nonkomersial LAN. Default tetap off.
# Isi secret sendiri secara privat; jangan commit atau kirim hasil Compose config/inspect.
MAIN_DULU_SCREENSCRAPER_ENABLED=false
# MAIN_DULU_SCREENSCRAPER_DEV_ID=
# MAIN_DULU_SCREENSCRAPER_DEV_PASSWORD=
# MAIN_DULU_SCREENSCRAPER_USER=
# MAIN_DULU_SCREENSCRAPER_PASSWORD=
# MAIN_DULU_SCREENSCRAPER_SOFTNAME=maindulu
# MAIN_DULU_SCREENSCRAPER_REGION=wor
# MAIN_DULU_SCREENSCRAPER_LANGUAGE=en

# CHD PS1 serial auto-apply (M7 lanjutan, opt-in). Membutuhkan ScreenScraper aktif.
# rom-converto v0.24.0 terpin otomatis dipasang saat build Docker; override manual opsional.
# MAIN_DULU_ROM_CONVERTO_PATH=
# MAIN_DULU_ROM_CONVERTO_TIMEOUT_MS=30000
# MAIN_DULU_CHD_SERIAL_AUTOAPPLY=true
