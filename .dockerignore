# Allowlist untuk kedua image. Data/backup di luar direktori sumber/aset yang
# diizinkan (termasuk nama custom), environment dan artefak host tidak ikut.
**
!package.json
!package-lock.json
!index.html
!vite.config.ts
!tsconfig.json
!tsconfig.app.json
!tsconfig.node.json
!src/
!src/**
!public/
!public/**
!server/
server/**
!server/*.mjs
!server/auth/
server/auth/**
!server/auth/*.mjs
!scripts/
scripts/**
!scripts/reset-account.mjs
!scripts/set-account-role.mjs
!scripts/data-backup.mjs
!deploy/
deploy/**
!deploy/Dockerfile
!deploy/Dockerfile.backend
!deploy/nginx.docker.conf
!deploy/healthcheck.mjs

# Bahkan di dalam direktori sumber yang diizinkan, jangan kirim data privat.
**/.env
**/.env.*
**/*.sqlite
**/*.sqlite-*
**/*.maindulu-lock
**/*.partial-*
**/node_modules
**/.git
