# Salin ke .env.backend di akar repo. Ganti IP dengan alamat tetap server Anda.
# HANYA LAN TEPERCAYA: password, cookie sesi, dan save tidak terenkripsi.
# Jangan port-forward/publikasikan konfigurasi HTTP ini ke internet.
MAIN_DULU_BIND_ADDRESS=0.0.0.0
MAIN_DULU_PORT=7777
MAIN_DULU_PUBLIC_ORIGIN=http://192.168.2.251:7777
MAIN_DULU_ALLOW_INSECURE_HTTP=true
MAIN_DULU_REGISTRATION_OPEN=true

# Opsional: folder data di dalam volume (ubah untuk restore ke folder baru).
# MAIN_DULU_CONTAINER_DATA_DIR=/var/lib/maindulu/data

# Opsional koleksi RomM, pilih SATU overlay:
# - docker-compose.external.yml: read-only; upload tetap internal.
# - docker-compose.shared.yml: upload + scan + hapus memakai folder yang sama.
# Folder host harus sudah ada; read-only perlu akses baca/traverse, shared perlu
# akses tulis/hapus oleh user container (default UID/GID 1000:1000) dan RomM.
# MAIN_DULU_ROM_PATH=/mnt/storage/romm/library/roms
# MAIN_DULU_BIOS_PATH=/mnt/storage/romm/library/bios
# Tanpa Docker, set path absolut sumber di environment backend:
# MAIN_DULU_EXTERNAL_ROM_DIR=/mnt/storage/romm/library/roms
# MAIN_DULU_EXTERNAL_BIOS_DIR=/mnt/storage/romm/library/bios
# Satu folder bersama upload + scan + hapus: gunakan docker-compose.shared.yml.
# Overlay mengaktifkan writable secara eksplisit; jangan gabung overlay read-only.
# PERHATIAN: Hapus maindulu menghapus file fisik yang dipakai RomM. Backup dulu.
# Tanpa overlay / tanpa Docker, aktifkan sendiri bila benar-benar diinginkan:
# MAIN_DULU_EXTERNAL_WRITABLE=true
# Kuota katalog default 20 GiB juga menghitung byte folder bersama; naikkan
# MAIN_DULU_CATALOG_QUOTA_BYTES sesuai koleksi sebelum upload jika diperlukan.
# Panduan YAML/Portainer/migrasi: doc/koleksi-folder-bersama.md

# Opsional: batas state/progres/cadangan (nilai default ditunjukkan).
# MAIN_DULU_STATE_MAX_BYTES=33554432
# MAIN_DULU_GAME_SAVE_MAX_BYTES=8388608
# MAIN_DULU_SAVE_QUOTA_BYTES=268435456
# MAIN_DULU_CATALOG_QUOTA_BYTES=21474836480
# MAIN_DULU_CATALOG_MIN_FREE_BYTES=268435456
# MAIN_DULU_CATALOG_UPLOAD_LIMIT=2
# MAIN_DULU_CATALOG_UPLOAD_TIMEOUT_MS=1800000

# ScreenScraper runtime, opt-in pribadi/nonkomersial LAN. Default tetap off.
# Isi secret sendiri secara privat; jangan commit atau kirim hasil Compose config/inspect.
MAIN_DULU_SCREENSCRAPER_ENABLED=false
# MAIN_DULU_SCREENSCRAPER_DEV_ID=
# MAIN_DULU_SCREENSCRAPER_DEV_PASSWORD=
# MAIN_DULU_SCREENSCRAPER_USER=
# MAIN_DULU_SCREENSCRAPER_PASSWORD=
# MAIN_DULU_SCREENSCRAPER_SOFTNAME=maindulu
# MAIN_DULU_SCREENSCRAPER_REGION=wor
# MAIN_DULU_SCREENSCRAPER_LANGUAGE=en
# Panduan enable/disable, quota, dan rollback: doc/milestone-6-screenscraper-operasi.md

# CHD PS1 serial auto-apply (M7 lanjutan, opt-in). Membutuhkan ScreenScraper aktif.
# rom-converto v0.24.0 terpin otomatis dipasang saat build Docker; override manual opsional.
# MAIN_DULU_ROM_CONVERTO_PATH=
# MAIN_DULU_ROM_CONVERTO_TIMEOUT_MS=30000
# MAIN_DULU_CHD_SERIAL_AUTOAPPLY=true

# Untuk HTTPS melalui reverse proxy, ubah menjadi:
# MAIN_DULU_BIND_ADDRESS=127.0.0.1
# MAIN_DULU_PUBLIC_ORIGIN=https://main.example.com
# MAIN_DULU_ALLOW_INSECURE_HTTP=false
# Variabel saja TIDAK memasang HTTPS/sertifikat.
