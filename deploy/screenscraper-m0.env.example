# TEMPLATE PUBLIK: jangan isi secret di file example ini.
# Jalankan npm run metadata:m0 -- init untuk membuat .env.screenscraper.local.
# Isi empat nilai kosong pada file lokal tersebut, bukan melalui argumen CLI/chat.
# Quote nilai yang mengandung spasi atau #. Password harus satu baris.
# File ini hanya untuk CLI M0, tidak dimuat Vite atau startup backend.
MAIN_DULU_SCREENSCRAPER_ENABLED=false
MAIN_DULU_SCREENSCRAPER_DEV_ID=
MAIN_DULU_SCREENSCRAPER_DEV_PASSWORD=
MAIN_DULU_SCREENSCRAPER_USER=
MAIN_DULU_SCREENSCRAPER_PASSWORD=
# Opsional; kosong memakai maindulu-<versi package.json>.
MAIN_DULU_SCREENSCRAPER_SOFTNAME=
