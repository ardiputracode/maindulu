# Opsi backend Node.js; Dockerfile Nginx/statis lama tetap terpisah.
FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY index.html vite.config.ts tsconfig.json tsconfig.app.json tsconfig.node.json ./
COPY src ./src
COPY public ./public
RUN npm run build

FROM node:24-alpine AS production-dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

FROM node:24-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    MAIN_DULU_HOST=0.0.0.0 \
    MAIN_DULU_PORT=7777 \
    MAIN_DULU_DIST_DIR=/app/dist \
    MAIN_DULU_DATA_DIR=/var/lib/maindulu/data
COPY --from=production-dependencies /app/package.json /app/package-lock.json ./
COPY --from=production-dependencies /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY server ./server
COPY scripts/reset-account.mjs scripts/data-backup.mjs ./scripts/
COPY deploy/healthcheck.mjs ./deploy/healthcheck.mjs
# Mount parent: data dan lock di sebelahnya harus berada pada volume yang sama.
RUN mkdir -p /var/lib/maindulu && chown node:node /var/lib/maindulu
USER node
VOLUME ["/var/lib/maindulu"]
EXPOSE 7777
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["node", "deploy/healthcheck.mjs"]
CMD ["node", "server/index.mjs"]
