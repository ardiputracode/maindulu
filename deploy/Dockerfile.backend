# Opsi backend Node.js; Dockerfile Nginx/statis lama tetap terpisah.
FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY index.html vite.config.ts tsconfig.json tsconfig.app.json tsconfig.node.json ./
COPY src ./src
COPY public ./public
COPY scripts/build-player-assets.mjs ./scripts/
ARG VITE_ASSET_CACHE_DISABLED=false
RUN npm run build

FROM node:24-alpine AS production-dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

FROM node:24-alpine AS runtime
WORKDIR /app
ARG ROM_CONVERTO_VERSION=0.24.0
ARG ROM_CONVERTO_SHA256=67964054931f7e74848bfe7b54ff1f0cacdc25596c29e3a79876f76e0f2407a8
# Alpine uses musl; the glibc asset is not compatible. Verify the pinned asset
# during the build and keep the binary outside the operator data volume.
RUN apk add --no-cache ca-certificates \
 && wget -q -O /tmp/rom-converto "https://github.com/DevYukine/rom-converto/releases/download/v${ROM_CONVERTO_VERSION}/rom-converto-cli-linux-x64-musl" \
 && echo "${ROM_CONVERTO_SHA256}  /tmp/rom-converto" | sha256sum -c - \
 && mkdir -p /app/vendor/rom-converto/linux-x64-musl \
 && mv /tmp/rom-converto /app/vendor/rom-converto/linux-x64-musl/rom-converto \
 && chmod 0755 /app/vendor/rom-converto/linux-x64-musl/rom-converto \
 && chown node:node /app/vendor/rom-converto/linux-x64-musl/rom-converto \
 && /app/vendor/rom-converto/linux-x64-musl/rom-converto --version
ENV NODE_ENV=production \
    MAIN_DULU_HOST=0.0.0.0 \
    MAIN_DULU_PORT=7777 \
    MAIN_DULU_DIST_DIR=/app/dist \
    MAIN_DULU_DATA_DIR=/var/lib/maindulu/data
COPY --from=production-dependencies /app/package.json /app/package-lock.json ./
COPY --from=production-dependencies /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY server ./server
# Modul format bersama diimpor langsung oleh server/game-saves.mjs (Node.js 24+).
COPY src/lib/game-save-format.ts ./src/lib/game-save-format.ts
COPY scripts/reset-account.mjs scripts/set-account-role.mjs scripts/data-backup.mjs scripts/recover-catalog.mjs ./scripts/
COPY deploy/healthcheck.mjs ./deploy/healthcheck.mjs
# Mount parent: data dan lock di sebelahnya harus berada pada volume yang sama.
RUN mkdir -p /var/lib/maindulu && chown node:node /var/lib/maindulu
USER node
VOLUME ["/var/lib/maindulu"]
EXPOSE 7777
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["node", "deploy/healthcheck.mjs"]
CMD ["node", "server/index.mjs"]
