# TEMPLATE PUBLIK TANPA SECRET ASLI. Isi Environment stack Portainer,
# atau salin ke .env.portainer di akar repo (diabaikan Git).
# Ganti origin dan path generik ini sesuai server, bukan path di container.
MAIN_DULU_PUBLIC_ORIGIN=http://192.168.1.10:7777
MAIN_DULU_ROM_PATH=/srv/romm/library/roms
MAIN_DULU_BIOS_PATH=/srv/romm/library/bios

# Opsional: image yang sudah tersedia di endpoint dan nama volume lama.
MAIN_DULU_IMAGE=maindulu-backend:latest
MAIN_DULU_STORAGE_VOLUME=maindulu-backend_storage
MAIN_DULU_BIND_ADDRESS=0.0.0.0
MAIN_DULU_PORT=7777

# ScreenScraper default nonaktif. Isi sendiri di Portainer, jangan di Git.
MAIN_DULU_SCREENSCRAPER_ENABLED=false
# MAIN_DULU_SCREENSCRAPER_DEV_ID=
# MAIN_DULU_SCREENSCRAPER_DEV_PASSWORD=
# MAIN_DULU_SCREENSCRAPER_USER=
# MAIN_DULU_SCREENSCRAPER_PASSWORD=
